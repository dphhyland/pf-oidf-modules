# pingfederate-runtime config-as-code — STAGING.
# Non-secret Railway service vars applied by the deploy workflow. Secrets are NEVER here — they are
# GitHub Actions secrets applied to the Railway service (see .github/workflows/deploy-pingfederate.yml).
#
# Licensing: DevOps-fetched (no baked pingfederate.lic). EULA acceptance is non-secret; the DevOps
# credentials (PING_IDENTITY_DEVOPS_USER / PING_IDENTITY_DEVOPS_KEY) are GitHub Actions secrets.
PING_IDENTITY_ACCEPT_EULA=YES

# SSF transmitter — set OIDF_SSF_ISSUER to this env's PF external base to turn the transmitter on at boot
# (see vars.production.env for the full option list; fail-soft when unset). Replace with the staging
# runtime TCP-proxy host.
OIDF_SSF_ISSUER=https://caboose.proxy.rlwy.net:38503
# Receiver-auth introspection client id/secret are GitHub Actions secrets (OIDF_SSF_INTROSPECTION_CLIENT_ID
# / OIDF_SSF_INTROSPECTION_CLIENT_SECRET), never here.

# REQUIRED since the modular jars: OpenIdFederationServlet is loadOnStartup=1 and kills pf-runtime.war
# at boot without a trust anchor (the old monolith initialised lazily so the var could be absent).
# Staging's trust anchor is the OpenID Federation Trust Controller — every staging entity's authority_hints points here.
OIDF_FEDERATION_TRUST_ANCHORS=https://trust-controller-staging.up.railway.app
# REQUIRED for attestation validation (even in DEV mock-attester mode): ClientAttestationUtils builds an
# HttpTrustControllerGateway from this — without it token-endpoint attestation auth NPEs
# (attestation_validation_failed).
OIDF_FEDERATION_TRUST_CONTROLLER_HOST=https://trust-controller-staging.up.railway.app
# REQUIRED with the line above: the trust controller's public Federation Entity Keys, pinned out of band
# (OpenID Federation 1.0 §4). Without it PF validates no trust chain - the filters log it at startup and
# refuse every federation-resolved client and attester. Public keys, so not a secret, but it IS trust
# configuration: change it only deliberately.
# Captured 2026-09-15 with ../pf-agentic-identity/tools/pin-trust-anchor.py over HTTPS from the anchor
# itself. That is trust-on-first-use - confirm the kid/thumbprint below against the key file on the
# trust-controller volume (LH_SIGNING_FILESYSTEM_KEY_DIR=/data/keys) before relying on it.
#   kid = RFC 7638 thumbprint = icyaNxdj6OHG9lSMPMQm6CuXP1Wf2e4aGT09V_qjDS8 (EC P-521, ES512)
# On an anchor key rollover, re-run the tool with --env-file and deploy BEFORE the anchor switches keys.
OIDF_FEDERATION_TRUST_ANCHOR_JWKS={"keys":[{"alg":"ES512","crv":"P-521","iat":1790113715,"kid":"8uVjksTmo63XwQli3bxU3Zi4Q7azQL1bl0faQZoQs4Y","kty":"EC","nbf":1790113715,"use":"sig","x":"AS7CeiImJaJxvMRHi4OnxPWQjJ7XeACodk96w6RlBqOl3yrf1ofrQKYQZHzH1LP4Vn-eF19Y6-tt8fizhponeft8","y":"AAOl3OKx_K2R69ED9NhXpmh03slA4OLO9-30jSyYb7GdJgehq4sSz71t3WKJYjhlPaqbkXxuGH_oYBU87_L6w5Le"}]}

# §12.1 automatic registration accepts a chain with NO oauth_client metadata_policy from a superior.
# The staging trust controller publishes no metadata_policy, so without this the auto-registration
# filter (correctly) refuses to register a client on its own self-published scope/grant_types and the
# token endpoint falls through to "Client not found". DEMO POSTURE ONLY — the right fix is a
# metadata_policy at the trust anchor, then delete this line.
OIDF_REQUIRE_METADATA_POLICY=false

# ── attest_jwt_client_auth bridge key ───────────────────────────────────────────────────────────
# PF has no native attestation-based client authentication. ClientAttestationAuthFilter translates a
# verified Client Attestation into a private_key_jwt assertion signed by this deployment-wide key,
# whose public half is added to each attestation client's JWKS at registration.
#
# The filter now REFUSES TO START without it, because the old behaviour was worse than a failed
# deploy: with no key the filter passed every request through, while registration created those
# clients as PUBLIC (ClientAuthenticationType.NONE) - so attestation clients were authenticated by
# nothing at all. Registration now also refuses to create an attestation client without it.
#
# No environment has ever had a bridge key, so this is set false to keep deploys working while the
# state is what it is. It makes the current posture explicit instead of silently true:
# attestation-based client authentication is INERT in this environment.
#
# To turn it on: generate an EC P-256 private JWK, set OIDF_BRIDGE_PRIVATE_JWK as a SEALED Railway
# variable (never here - this file is versioned), delete the line below, and redeploy. Rotate with
# OIDF_BRIDGE_PREVIOUS_PUBLIC_JWK set to the outgoing public half during the overlap.
# UPDATE 2026-10-27: on 0.8.0 the setting is OIDF_BRIDGE_SIGNING_KEYS, a JSON file mapping each client id
# to {"jwk": ...} (OIDF_BRIDGE_PRIVATE_JWK was retired in 0.1.2 and is refused). The rig's agent types
# (agents/README.md) need one key each; the file is a secret, materialised at apply time. Delete the line
# below when it is in place.
OIDF_ATTESTATION_REQUIRE_BRIDGE_KEY=false

# ── The observatory's rig: agent types, their RAR type, the registers ────────────────────────────
# agents/README.md is the runbook. The types agentd-docker and agentd-railway are self-signed hosted
# entities at <OIDF_AUTHORITY_ENTITY_ID>/federation/agents/<id>; their instances present a Client
# Attestation the observatory minted (it is the oauth_client_attester, resolved through the chain).
# Hosting: the entity id every hosted agent's id is built from (never the request's Host). The runtime's
# external base, the same value as OIDF_SSF_ISSUER; re-check both when the environment is restored.
OIDF_AUTHORITY_ENTITY_ID=https://caboose.proxy.rlwy.net:38503
# The authorization_details type a runner's token carries, and its model: pool by equality, repos as a
# set. The ceiling comes from the instance's attestation, so no per-client ceiling is configured.
OIDF_RAR_EXTRA_TYPES=agent-runner
OIDF_RAR_MODELS={"types":{"agent-runner":{"fields":{"pool":"equal","repos":"set"}}}}
# The AgentInstance SCIM resource and CAEP for the registers of PingFederate's own attester. The rig's
# instances are minted by the observatory, so they are not in those registers (agents/README.md).
OIDF_SCIM_AGENT_INSTANCES=true
OIDF_CLIENT_REVOCATION_CAEP=true
